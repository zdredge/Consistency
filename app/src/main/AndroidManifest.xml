<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Exact alarms: install-granted, no runtime prompt, because this app is sideloaded to one
      personal device and never goes through Play review. Verified in M0 - canScheduleExactAlarms()
      returned true with no prompt ever shown. Publishing would invalidate this and require the
      inexact fallback the architecture deliberately does not build (architecture 2).
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Runtime-requested on first launch; denial is reported on Home rather than nagged about. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarms are wiped by a restart. Without this one reboot silently ends every prompt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Steps (M7). A runtime permission; declining it HIDES steps rather than offering manual entry,
      which is permanently out of scope (spec 2, 3.3). Framework Health Connect needs no separate
      install at minSdk 34 - confirmed in M0.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <application
        android:name=".ConsistencyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Consistency">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Consistency"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Not exported: only this app's own alarms may trigger a check-in prompt. The PendingIntent
          holds the component explicitly, so nothing external needs to reach it.
        -->
        <receiver
            android:name=".notify.CheckInAlarmReceiver"
            android:exported="false" />

        <!--
          Where the system sends the user to find out why this app wants health data.

          An activity-alias guarded by START_VIEW_PERMISSION_USAGE, which is the Android 14+ form -
          the only one needed at minSdk 34. The M0 spike put the intent-filter straight on
          MainActivity with no permission guard; its own comment said to verify that against current
          docs before reusing it, and this is that verification. Without the guard any app could
          launch it.
        -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Exported by necessity: the system delivers both of these from outside the app. A reboot
          wipes pending alarms, and so does replacing the package - without the second action every
          install silently ended all prompting until the app was next opened by hand.
        -->
        <receiver
            android:name=".notify.ScheduleRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>